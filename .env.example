# ── SwingTrade AI Scanner configuration ─────────────────────────────────────
# Copy to .env and fill in what you have. Every variable is optional:
# with no keys at all the app runs fully in sample-data mode.

# ── Core ────────────────────────────────────────────────────────────────────
# sqlite+aiosqlite:///./swingtrade.db  (local dev, default)
# postgresql+asyncpg://swing:swing@db:5432/swingtrade  (docker compose)
DATABASE_URL=sqlite+aiosqlite:///./swingtrade.db
REDIS_URL=redis://localhost:6379/0

# Secret used to sign JWTs — change in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=change-me
# Fernet key for encrypting user-saved API keys at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Market data provider ────────────────────────────────────────────────────
# sample  — deterministic synthetic data, zero keys required
# polygon — Massive (formerly Polygon.io); set POLYGON_API_KEY
# alpaca  — Alpaca Market Data; set ALPACA_API_KEY / ALPACA_API_SECRET
DATA_PROVIDER=sample

POLYGON_API_KEY=
POLYGON_BASE_URL=https://api.polygon.io
# Requests/minute budget for the Massive/Polygon key (free tier = 5)
POLYGON_RPM=5

ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_URL=https://data.alpaca.markets

# ── AI analysis provider ────────────────────────────────────────────────────
# sample — templated analysis built from live indicator values, no key needed
# openai — set OPENAI_API_KEY
AI_PROVIDER=sample
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Scanner behaviour ───────────────────────────────────────────────────────
# How often the ingestion → indicators → scoring → alerts cycle runs
SCAN_INTERVAL_SECONDS=60
# Trading days of daily history to backfill (250+ needed for EMA-200)
HISTORY_DAYS=504
# Max symbols scored per cycle (universe is seeded with ~150 liquid names)
UNIVERSE_LIMIT=500
